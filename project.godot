; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/accessibility_support=2
general/updates_per_second=100

[application]

config/name="BioShock Launcher"
config/name_localized={
"es_MX": ""
}
run/main_scene="uid://bavhps2wgtwrj"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="uid://baaoxlgncqwbm"
config/macos_native_icon="res://mac.icns"
config/windows_native_icon="res://windows.ico"

[display]

window/size/initial_position_type=4
window/size/resizable=false
window/stretch/mode="viewport"
window/handheld/orientation=4
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="New Game Project"

[editor_plugins]

enabled=PackedStringArray("res://addons/coi_serviceworker/plugin.cfg")

[importer_defaults]

oggvorbisstr={
&"loop": true
}

